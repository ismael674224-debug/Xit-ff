<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/painel_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_painel">

    <!-- Barra de Título (Arrastável) -->
    <LinearLayout
        android:id="@+id/barra_titulo"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#CC0000"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DELTA CHEATS EXTERNAL v2.0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btn_fechar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Conteúdo Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Menu Lateral (Abas) -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView android:id="@+id/tab_aim" android:layout_width="40dp" android:layout_height="40dp" android:background="#FF0000" android:padding="8dp" android:src="@android:drawable/ic_menu_mylocation" android:layout_marginBottom="8dp"/>
            <ImageView android:id="@+id/tab_esp" android:layout_width="40dp" android:layout_height="40dp" android:background="#222222" android:padding="8dp" android:src="@android:drawable/ic_menu_view" android:layout_marginBottom="8dp"/>
            <ImageView android:id="@+id/tab_rage" android:layout_width="40dp" android:layout_height="40dp" android:background="#222222" android:padding="8dp" android:src="@android:drawable/ic_menu_compass" android:layout_marginBottom="8dp"/>
            <ImageView android:id="@+id/tab_cfg" android:layout_width="40dp" android:layout_height="40dp" android:background="#222222" android:padding="8dp" android:src="@android:drawable/ic_menu_preferences" />
        </LinearLayout>

        <!-- Área de Funções -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="#1A1A1A"
            android:padding="8dp">

            <!-- ABA AIMBOT -->
            <LinearLayout android:id="@+id/page_aim" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠ Funções Aimbot" android:textColor="#FFCC00" android:textSize="12sp" android:layout_marginBottom="8dp"/>
                
                <CheckBox android:id="@+id/cb_aim_silent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aim Silent" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000" android:checked="true"/>
                <CheckBox android:id="@+id/cb_aim_360" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aim 360" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000"/>
                <CheckBox android:id="@+id/cb_auto_fire" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto Fire" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000"/>
            </LinearLayout>

            <!-- ABA ESP -->
            <LinearLayout android:id="@+id/page_esp" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠ Funções ESP" android:textColor="#FFCC00" android:textSize="12sp" android:layout_marginBottom="8dp"/>
                
                <CheckBox android:id="@+id/cb_esp_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESP Box" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000" android:checked="true"/>
                <CheckBox android:id="@+id/cb_esp_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESP Line" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000"/>
                <CheckBox android:id="@+id/cb_esp_health" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESP Health" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000"/>
            </LinearLayout>

            <!-- ABA RAGE (Spin Bot) -->
            <LinearLayout android:id="@+id/page_rage" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠ Funções Rage" android:textColor="#FFCC00" android:textSize="12sp" android:layout_marginBottom="8dp"/>
                
                <CheckBox android:id="@+id/cb_spin_bot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spin Bot" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000"/>
                <CheckBox android:id="@+id/cb_speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speed Hack" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000"/>
                <CheckBox android:id="@+id/cb_no_recoil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No Recoil" android:textColor="#FFF" android:textSize="12sp" android:buttonTint="#FF0000"/>
            </LinearLayout>

            <!-- ABA CONFIG -->
            <LinearLayout android:id="@+id/page_cfg" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙ Personalização" android:textColor="#00FF00" android:textSize="12sp" android:layout_marginBottom="8dp"/>
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cor do painel" android:textColor="#FFF" android:textSize="12sp"/>
                <View android:layout_width="match_parent" android:layout_height="20dp" android:background="#FF0000" android:layout_marginBottom="8dp"/>
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cor da ESP" android:textColor="#FFF" android:textSize="12sp"/>
                <View android:layout_width="match_parent" android:layout_height="20dp" android:background="#FFFFFF"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
